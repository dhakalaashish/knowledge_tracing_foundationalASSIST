# v5 labels, FULL RUN in ONE job: rows 301-3395 (Code/generate_practice_reasoning/tacc_run_v5.sh), after the rows
# 1-300 test is checked. One h100 node; one job waits for one free node, which matters when the queue is crowded.
# (job_full_a.env + job_full_b.env split the same rows over two nodes at once: half the time once both run, same cost.)
# From $WORK/stampede3:
#   bash slurm/gen_job/job_setup.sh FoundationalASSIST/config/job_full.env
# Expected: about 25-40 h; 48 h limit (the queue maximum). If it is stopped at the limit, submit it again: it resumes
# where it stopped. Cost: 4 SU per node-hour, so about 100-160 SU.

TACC_SYSTEM=stampede3
TACC_HOST=stampede3.tacc.utexas.edu

# Portal project charge code (#SBATCH -A): replace before committing
ALLOCATION=YOUR_ALLOCATION

QUEUE=h100
JOB_NAME=v5_full
NODES=1
NTASKS=1
WALLTIME=48:00:00

STDOUT_FILE=v5_full.o%j
STDERR_FILE=v5_full.e%j

WORKDIR_ROOT=SCRATCH
MODULES=tacc-apptainer
LAUNCH_MODE=gpu
OMP_NUM_THREADS=1

EXECUTABLE=bash
EXECUTABLE_ARGS=tacc_run_v5.sh
COPY_INPUTS=Code/generate_practice_reasoning/tacc_run_v5.sh

# Application settings (exported to tacc_run_v5.sh)
V5_ROWS=301-3395
