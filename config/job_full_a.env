# v5 labels, FULL RUN part A: rows 301-1705 (Code/generate_practice_reasoning/tacc_run_v5.sh). Submit it together
# with job_full_b.env (rows 1706-3395) after the rows 1-300 test is checked; the two parts have about the same work
# (5,996 and 5,706 wrong answers) and run at the same time on two h100 nodes (the queue allows 2 jobs per user).
# From $WORK/stampede3:
#   bash slurm/gen_job/job_setup.sh FoundationalASSIST/config/job_full_a.env
# Expected: about 12-20 h; 48 h limit (the queue maximum). If a part is stopped at the limit, submit it again: it
# resumes where it stopped. Cost: 4 SU per node-hour, so about 50-80 SU per part.

TACC_SYSTEM=stampede3
TACC_HOST=stampede3.tacc.utexas.edu

# Portal project charge code (#SBATCH -A): replace before committing
ALLOCATION=YOUR_ALLOCATION

QUEUE=h100
JOB_NAME=v5_full_a
NODES=1
NTASKS=1
WALLTIME=48:00:00

STDOUT_FILE=v5_full_a.o%j
STDERR_FILE=v5_full_a.e%j

WORKDIR_ROOT=SCRATCH
MODULES=tacc-apptainer
LAUNCH_MODE=gpu
OMP_NUM_THREADS=1

EXECUTABLE=bash
EXECUTABLE_ARGS=tacc_run_v5.sh
COPY_INPUTS=Code/generate_practice_reasoning/tacc_run_v5.sh

# Application settings (exported to tacc_run_v5.sh)
V5_ROWS=301-1705
