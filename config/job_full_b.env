# v5 labels, FULL RUN part B: rows 1706-3395 (Code/generate_practice_reasoning/tacc_run_v5.sh). Submit together with
# job_full_a.env (rows 301-1705) after the rows 1-300 test is checked. From $WORK/stampede3:
#   bash slurm/gen_job/job_setup.sh FoundationalASSIST/config/job_full_b.env
# Expected: about 12-20 h; 48 h limit (the queue maximum). If stopped at the limit, submit it again: it resumes.
# Cost: 4 SU per node-hour, so about 50-80 SU.

TACC_SYSTEM=stampede3
TACC_HOST=stampede3.tacc.utexas.edu

# Portal project charge code (#SBATCH -A): replace before committing
ALLOCATION=YOUR_ALLOCATION

QUEUE=h100
JOB_NAME=v5_full_b
NODES=1
NTASKS=1
WALLTIME=48:00:00

STDOUT_FILE=v5_full_b.o%j
STDERR_FILE=v5_full_b.e%j

WORKDIR_ROOT=SCRATCH
MODULES=tacc-apptainer
LAUNCH_MODE=gpu
OMP_NUM_THREADS=1

EXECUTABLE=bash
EXECUTABLE_ARGS=tacc_run_v5.sh
COPY_INPUTS=Code/generate_practice_reasoning/tacc_run_v5.sh

# Application settings (exported to tacc_run_v5.sh)
V5_ROWS=1706-3395
