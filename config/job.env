# v5 labels, TEST RUN: rows 1-300 (Code/generate_practice_reasoning/tacc_run_v5.sh).
# TACC Stampede3, queue h100: 1 node with 4x H100 96 GB (Qwen3.5-122B-FP8 needs about 130 GB; it does not fit on a
# Vista GH node or a Lonestar6 gpu-h100 node). From $WORK/stampede3 (the folder with slurm/ and FoundationalASSIST/):
#   bash slurm/gen_job/job_setup.sh FoundationalASSIST/config/job.env
# Expected: about 3-4 h (first job also pulls the vLLM image and downloads the model, about 30-60 min); 8 h limit.
# Cost: 4 SU per node-hour of actual run time, so about 15-20 SU.

TACC_SYSTEM=stampede3
TACC_HOST=stampede3.tacc.utexas.edu

# Portal project charge code (#SBATCH -A): replace before committing
ALLOCATION=YOUR_ALLOCATION

QUEUE=h100
JOB_NAME=v5_rows300
NODES=1
NTASKS=1
WALLTIME=08:00:00

STDOUT_FILE=v5_rows300.o%j
STDERR_FILE=v5_rows300.e%j

WORKDIR_ROOT=SCRATCH
MODULES=tacc-apptainer
LAUNCH_MODE=gpu
OMP_NUM_THREADS=1

EXECUTABLE=bash
EXECUTABLE_ARGS=tacc_run_v5.sh
COPY_INPUTS=Code/generate_practice_reasoning/tacc_run_v5.sh

# Application settings (exported to tacc_run_v5.sh)
V5_ROWS=1-300
