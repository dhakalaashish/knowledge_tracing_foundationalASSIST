<table style=""border-collapse: collapse; width: 44.7231%; height: 136px;"" border=""1"">
<tbody>
<tr style=""height: 32.6667px;"">
<td style=""width: 50.003%; text-align: center; height: 32.6667px;""><strong>original price</strong></td>
<td style=""width: 50.003%; text-align: center; height: 32.6667px;""><strong>sale price</strong></td>
</tr>
<tr style=""height: 32.6667px;"">
<td style=""width: 50.003%; text-align: center; height: 32.6667px;"">$15</td>
<td style=""width: 50.003%; text-align: center; height: 32.6667px;"">$10</td>
</tr>
<tr style=""height: 32.6667px;"">
<td style=""width: 50.003%; text-align: center; height: 32.6667px;"">$25</td>
<td style=""width: 50.003%; text-align: center; height: 32.6667px;"">$20</td>
</tr>
<tr style=""height: 32.6667px;"">
<td style=""width: 50.003%; text-align: center; height: 32.6667px;"">$35</td>
<td style=""width: 50.003%; text-align: center; height: 32.6667px;"">$30</td>
</tr>
</tbody>
</table>",,,"<p>Yes, it is proportional</p> || <p>No, it is not proportional</p>","<p>No, it is not proportional</p>",24484
