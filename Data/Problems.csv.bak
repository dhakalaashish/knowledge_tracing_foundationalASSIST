<table style=""height: 290px; width: 343px;"" border=""1"">
<tbody>
<tr>
<td style=""width: 165.714px; text-align: center;""><span style=""font-size: 12pt;""><strong>material</strong></span></td>
<td style=""width: 164.714px; text-align: center;""><span style=""font-size: 12pt;""><strong>speed (meters per second)</strong></span></td>
</tr>
<tr>
<td style=""width: 165.714px; text-align: center;""><span style=""font-size: 12pt;""><strong>space</strong></span></td>
<td style=""width: 164.714px; text-align: center;""><span style=""font-size: 12pt;"">300,000,000</span></td>
</tr>
