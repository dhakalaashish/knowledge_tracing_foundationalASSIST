PRABQPZ2,1,Multiple Choice (select 1),Multiple Choice,"<p>Which of the systems of equations has a solution of <math xmlns=""http://www.w3.org/1998/Math/MathML""><mo>(</mo><mo>-</mo><mn>2</mn><mo>,</mo><mo>&#160;</mo><mn>6</mn><mo>)</mo></math>?</p>",,,"<p><math xmlns=""http://www.w3.org/1998/Math/MathML""><mfenced open=""{"" close=""""><mtable columnalign=""left""><mtr><mtd><mi mathvariant=""normal"">y</mi><mo>=</mo><mn>2</mn><mi mathvariant=""normal"">x</mi><mo>+</mo><mn>10</mn></mtd></mtr><mtr><mtd><mi mathvariant=""normal"">y</mi><mo>=</mo><mn>3</mn><mi mathvariant=""normal"">x</mi><mo>-</mo><mn>6</mn></mtd></mtr></mtable></mfenced></math></p> || <p><math xmlns=""http://www.w3.org/1998/Math/MathML""><mo>&#160;</mo><mfenced open=""{"" close=""""><mtable columnalign=""left""><mtr><mtd><mi mathvariant=""normal"">y</mi><mo>-</mo><mn>2</mn><mi mathvariant=""normal"">x</mi><mo>=</mo><mn>2</mn></mtd></mtr><mtr><mtd><mi mathvariant=""normal"">y</mi><mo>+</mo><mn>2</mn><mi mathvariant=""normal"">x</mi><mo>=</mo><mn>10</mn></mtd></mtr></mtable></mfenced></math></p> || <p><math xmlns=""http://www.w3.org/1998/Math/MathML""><mfenced open=""{"" close=""""><mtable columnalign=""left""><mtr><mtd><mi mathvariant=""normal"">x</mi><mo>-</mo><mi mathvariant=""normal"">y</mi><mo>=</mo><mn>9</mn></mtd></mtr><mtr><mtd><mi mathvariant=""normal"">y</mi><mo>=</mo><mi mathvariant=""normal"">x</mi><mo>+</mo><mn>9</mn></mtd></mtr></mtable></mfenced></math></p> || <p><math xmlns=""http://www.w3.org/1998/Math/MathML""><mo>&#160;</mo><mfenced open=""{"" close=""""><mtable columnalign=""left""><mtr><mtd><mi mathvariant=""normal"">x</mi><mo>+</mo><mn>2</mn><mi mathvariant=""normal"">y</mi><mo>&#160;</mo><mo>=</mo><mn>10</mn></mtd></mtr><mtr><mtd><mo>-</mo><mn>4</mn><mi mathvariant=""normal"">x</mi><mo>-</mo><mi mathvariant=""normal"">y</mi><mo>=</mo><mn>2</mn></mtd></mtr></mtable></mfenced></math></p>","<p><math xmlns=""http://www.w3.org/1998/Math/MathML""><mo>&#160;</mo><mfenced open=""{"" close=""""><mtable columnalign=""left""><mtr><mtd><mi mathvariant=""normal"">x</mi><mo>+</mo><mn>2</mn><mi mathvariant=""normal"">y</mi><mo>&#160;</mo><mo>=</mo><mn>10</mn></mtd></mtr><mtr><mtd><mo>-</mo><mn>4</mn><mi mathvariant=""normal"">x</mi><mo>-</mo><mi mathvariant=""normal"">y</mi><mo>=</mo><mn>2</mn></mtd></mtr></mtable></mfenced></math></p>",77479
