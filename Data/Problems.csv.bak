<tr>
<td style=""width: 49.9489%; text-align: center;""><strong>Tuesday</strong></td>
<td style=""width: 49.9489%; text-align: center;"">-125</td>
</tr>
<tr>
<td style=""width: 49.9489%; text-align: center;""><strong>Wednesday</strong></td>
<td style=""width: 49.9489%; text-align: center;"">-127</td>
</tr>
<tr>
<td style=""width: 49.9489%; text-align: center;""><strong>Thursday</strong></td>
<td style=""width: 49.9489%; text-align: center;"">+1,719</td>
</tr>
<tr>
<td style=""width: 49.9489%; text-align: center;""><strong>Friday</strong></td>
<td style=""width: 49.9489%; text-align: center;"">-356</td>
</tr>
<tr>
<td style=""width: 49.9489%; text-align: center;""><strong>Saturday</strong></td>
<td style=""width: 49.9489%; text-align: center;"">-782</td>
</tr>
<tr>
<td style=""width: 49.9489%; text-align: center;""><strong>Sunday</strong></td>
