PRABQP5W,1,Multiple Choice (select all),Check All That Apply,"<p>Select&nbsp;<strong>all</strong> the expressions that equal&nbsp;<math xmlns=""http://www.w3.org/1998/Math/MathML""><msup><mn>2</mn><mn>8</mn></msup><mo>&#183;</mo><msup><mn>2</mn><mn>4</mn></msup></math>.</p>",,,"<p><math xmlns=""http://www.w3.org/1998/Math/MathML""><msup><mn>2</mn><mn>4</mn></msup></math></p> || <p><math xmlns=""http://www.w3.org/1998/Math/MathML""><msup><mn>2</mn><mn>12</mn></msup></math></p> || <p><math xmlns=""http://www.w3.org/1998/Math/MathML""><msup><mn>4</mn><mn>6</mn></msup></math></p> || <p><math xmlns=""http://www.w3.org/1998/Math/MathML""><msup><mn>2</mn><mn>32</mn></msup></math></p> || <p><math xmlns=""http://www.w3.org/1998/Math/MathML""><msup><mn>4</mn><mn>32</mn></msup></math></p>","<p><math xmlns=""http://www.w3.org/1998/Math/MathML""><msup><mn>2</mn><mn>12</mn></msup></math></p> || <p><math xmlns=""http://www.w3.org/1998/Math/MathML""><msup><mn>4</mn><mn>6</mn></msup></math></p>",156590
