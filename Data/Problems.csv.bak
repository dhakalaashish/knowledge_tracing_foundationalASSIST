PSBCKRX,1,Multiple Choice (select 1),Multiple Choice,"<p>For the pair of numbers below, select the number that is greater.</p>",,,"<p><span><span><span><span><span><math xmlns=""http://www.w3.org/1998/Math/MathML""><mn>2</mn><mo>&nbsp;</mo><mo>·</mo><mo>&nbsp;</mo><msup><mn>10</mn><mn>6</mn></msup></math></span></span></span></span></span>&nbsp;</p> || <p><math xmlns=""http://www.w3.org/1998/Math/MathML""><mn>7</mn><mo>.</mo><mn>839</mn><mo>&nbsp;</mo><mo>·</mo><mo>&nbsp;</mo><msup><mn>10</mn><mn>6</mn></msup></math><span><span><span><span></span></span></span></span>&nbsp;</p>","<p><math xmlns=""http://www.w3.org/1998/Math/MathML""><mn>7</mn><mo>.</mo><mn>839</mn><mo>&nbsp;</mo><mo>·</mo><mo>&nbsp;</mo><msup><mn>10</mn><mn>6</mn></msup></math><span><span><span><span></span></span></span></span>&nbsp;</p>",398730
