<td style=""text-align: center;"">16</td>
<td style=""text-align: center;"">34</td>
</tr>
<tr>
<td style=""text-align: center;""><strong>monarch</strong></td>
<td style=""text-align: center;"">24</td>
<td style=""text-align: center;"">46</td>
</tr>
</tbody>
