<tbody>
<tr style=""height: 24px;"">
<td style=""height: 24px; width: 147.375px;"">&nbsp;</td>
<td style=""height: 24px; width: 97.125px;""><strong>Train A</strong></td>
<td style=""height: 24px; width: 106.5px;""><strong>Train B</strong></td>
</tr>
<tr style=""height: 24px;"">
<td style=""height: 24px; width: 147.375px;""><strong>Starting Position</strong></td>
<td style=""height: 24px; width: 97.125px;"">0 Miles</td>
<td style=""height: 24px; width: 106.5px;"">320 Miles</td>
</tr>
<tr style=""height: 24px;"">
<td style=""height: 24px; width: 147.375px;""><strong>After 1 Hour</strong></td>
<td style=""height: 24px; width: 97.125px;"">70 Miles</td>
<td style=""height: 24px; width: 106.5px;"">270 Miles</td>
</tr>
<tr style=""height: 24px;"">
<td style=""height: 24px; width: 147.375px;""><strong>After 2 Hours</strong></td>
<td style=""height: 24px; width: 97.125px;"">&nbsp;</td>
<td style=""height: 24px; width: 106.5px;"">&nbsp;</td>
</tr>
<tr style=""height: 24px;"">
<td style=""height: 24px; width: 147.375px;"">&nbsp;</td>
<td style=""height: 24px; width: 97.125px;"">&nbsp;</td>
<td style=""height: 24px; width: 106.5px;"">&nbsp;</td>
</tr>
<tr style=""height: 24px;"">
